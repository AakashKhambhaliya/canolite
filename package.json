{
  "name": "canolite",
  "version": "1.13.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:backup": "tsx src/db/backup.ts",
    "worker": "tsx src/queue/worker.ts",
    "test": "npm run test:unit",
    "test:unit": "tsx tests/unit/test-all.ts && tsx tests/unit/test-video-fast-path.ts && tsx tests/unit/test-ordered-frame-pipeline.ts && tsx tests/unit/test-security.ts && tsx tests/unit/test-sandbox-fallback.ts && tsx --test tests/editor/limits.test.ts tests/unit/audit-fixes.test.ts",
    "test:comparison": "tsx tests/comparison/compare-paths.ts",
    "test:studio": "node tests/editor/studio-smoke.mjs && node tests/editor/studio-resilience.mjs",
    "typecheck": "tsc --noEmit",
    "test:studio:media": "node tests/editor/studio-media.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toggle": "^1.1.1",
    "@radix-ui/react-toggle-group": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-query": "^5.101.0",
    "@types/archiver": "^8.0.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.78.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "fabric": "^7.4.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^1.17.0",
    "next": "^15.5.29",
    "pg": "^8.21.0",
    "playwright": "1.60.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.2.0",
    "uuid": "^11.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.28.0",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss",
      "sharp": "$sharp"
    },
    "readdir-glob": {
      "minimatch": "^11.0.9"
    },
    "brace-expansion@^1": "1.1.22",
    "js-yaml@^4": "4.3.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.9"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
