# Database
# Leave DATABASE_URL unset for zero-config embedded PostgreSQL on 127.0.0.1.
# Production should use a managed/external PostgreSQL connection string.
# DATABASE_URL=postgresql://canolite:canolite@localhost:5432/canolite
PGDATA_DIR=./data/pgdata
PGPORT=54329
DB_POOL_MAX=10
# DB_SSL=disable      # opt out of automatic SSL for non-local PostgreSQL hosts
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECTION_TIMEOUT_MS=10000

# Redis — OPTIONAL, and not needed for a normal install. Renders run
# synchronously in-process; this is read only by the standalone BullMQ worker
# (`npm run worker`) if you choose to run renders out-of-process.
# REDIS_URL=redis://localhost:6379

# Auth — single admin, no public sign-up.
# By default you create the admin account in the browser on first run (setup
# wizard), then change the password anytime from Settings.
# OPTIONAL: set BOTH of these to auto-provision the admin on boot and skip the
# wizard (handy for Docker / headless deploys).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me
#
# There is no session-signing secret to set: a session is a random token stored
# in the database. AUTH_SECRET and NEXTAUTH_URL used to be listed here and were
# never read by anything — if you have them set, they can go.

# Storage is the local filesystem (see STORAGE_DIR below), not S3. The S3_*
# / MinIO settings that used to live here were unused and have been removed.

# App
APP_URL=http://localhost:3000
RENDER_CONCURRENCY=3
MAX_UPLOAD_MB=10

# Storage — root for rendered images and uploads.
# Defaults to public/storage (local dev). In Docker this is set to
# /app/data/storage so all state lives under the single /app/data volume.
# STORAGE_DIR=/app/data/storage

# Backups — where automatic backups are written. Defaults to /app/data/backups
# in Docker, or ./.backups without it.
# BACKUP_DIR=/app/data/backups

# Persistence guard — when "1", refuse to boot if /app/data is not a mounted
# volume (only meaningful in Docker; the Dockerfile enables it by default).
# REQUIRE_PERSISTENT_DATA=1

# Demo data — whether to insert the demo "Dealer Poster" template on a fresh
# database. Defaults to false in production, true in development.
# SEED_DEMO_DATA=false

# Coolify in-app updates (server-side only — NEVER prefix with NEXT_PUBLIC_).
# Set all three to enable the one-click "Update now" button on Coolify.
# Create an API token under Keys & Tokens scoped to the "deploy" permission only.
# COOLIFY_URL=https://coolify.example.com
# COOLIFY_API_TOKEN=your-deploy-scoped-token
# COOLIFY_APP_UUID=your-app-uuid

# Video upload/render support
# Optional when ffmpeg-static/ffprobe-static are available; set these for system binaries.
# ffmpeg-static is CPU-only: hardware VIDEO_ENCODER values (h264_nvenc,
# h264_vaapi, h264_videotoolbox) require a system ffmpeg via FFMPEG_PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
MAX_VIDEO_UPLOAD_MB=100
MAX_VIDEO_DURATION_SEC=60
MAX_VIDEO_PIXELS=8294400
VIDEO_RENDER_TIMEOUT_MS=900000
VIDEO_DEFAULT_FPS=30
VIDEO_MAX_FPS=60
VIDEO_MAX_OUTPUT_SEC=120
VIDEO_CONCURRENCY=1
VIDEO_PROBE_TIMEOUT_MS=60000
VIDEO_POSTER_TIMEOUT_MS=60000

# Video renderer (docs/video-rendering.md)
# Simple templates (axis-aligned, constant-opacity video layers) render on a
# fast ffmpeg filter-graph path; everything else uses the legacy Chromium
# loop automatically. Set 1 to always use the legacy loop (debugging).
# VIDEO_FORCE_LEGACY_RENDERER=1
# Parallel Chromium pages painting frames on the legacy path (default = CPU count).
# VIDEO_FRAME_WORKERS=4
# Memory budget for the fast path's looping-layer frame cache; layers above it
# fall back to the legacy path (which loops from disk).
# VIDEO_FFMPEG_LOOP_MEMORY_MB=512
# Video encoder: libx264 (default) | h264_nvenc | h264_vaapi | h264_videotoolbox.
# Hardware encoders need a system ffmpeg via FFMPEG_PATH (see note above).
# VIDEO_ENCODER=libx264
