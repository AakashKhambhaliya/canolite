# Database
DATABASE_URL=postgresql://canolite:canolite@localhost:5432/canolite

# Redis
REDIS_URL=redis://localhost:6379

# Auth — single admin, no public sign-up.
# By default you create the admin account in the browser on first run (setup
# wizard), then change the password anytime from Settings.
# OPTIONAL: set BOTH of these to auto-provision the admin on boot and skip the
# wizard (handy for Docker / headless deploys).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me
AUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=canolite
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# App
APP_URL=http://localhost:3000
RENDER_CONCURRENCY=3
MAX_UPLOAD_MB=10
